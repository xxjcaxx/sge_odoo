# =========================
# Build
# =========================
FROM node:22-slim AS build

WORKDIR /app

# Cambiar temporalmente a root para permitir la compilación de paquetes nativos
USER root

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build


# =========================
# Production
# =========================
FROM node:22-slim AS production

WORKDIR /app

ENV NODE_ENV=production

# Cambiar también a root en producción si vas a copiar los node_modules con permisos correctos
USER root

COPY package*.json ./

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server

EXPOSE 3000

CMD ["node", "server/index.js"]